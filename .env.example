# ──────────────────────────────────────────────────────────────────────────────
# ZAM / Theme Market Slack support agent — example configuration
#
# Copy to `.env` for local development, or export these from your secrets
# manager in production. NEVER commit a filled-in copy of this file.
# Values below are PLACEHOLDERS: no real token, key or Slack ID is included.
# Look every Slack ID up in your own workspace — do not guess one.
# ──────────────────────────────────────────────────────────────────────────────

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot User OAuth Token from "OAuth & Permissions" (starts with xoxb-). Required.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# "socket" (default) = Socket Mode, no public URL needed. Needs SLACK_APP_TOKEN.
# "http"             = Events API over HTTPS. Needs SLACK_SIGNING_SECRET.
SLACK_MODE=socket

# App-Level Token with the connections:write scope (starts with xapp-).
# Required when SLACK_MODE=socket.
SLACK_APP_TOKEN=xapp-your-app-level-token

# From "Basic Information → Signing Secret". Required when SLACK_MODE=http.
SLACK_SIGNING_SECRET=your-signing-secret

# The channel the agent watches. In Slack: right-click the channel →
# "View channel details" → the ID at the bottom (starts with C).
# Comma-separate to watch several channels.
#
# For this deployment the channel is #zam-ask-here, whose ID is C0204TKHWSZ.
SLACK_CHANNEL_ID=C0204TKHWSZ
# SLACK_CHANNEL_IDS=C00000000000,C11111111111

# Channels allowed to see documents marked `audience: internal`.
# Defaults to SLACK_CHANNEL_ID(S).
# INTERNAL_CHANNEL_IDS=C00000000000

# Channels allowed to see documents marked `audience: restricted`.
# Leave EMPTY for a company-wide channel: restricted documents are then never
# surfaced and such questions are escalated to a human instead.
RESTRICTED_CHANNEL_IDS=

# Port for SLACK_MODE=http.
PORT=3000

# ── Human escalation ──────────────────────────────────────────────────────────
# Slack *user* ID (starts with U) or user-group ID (starts with S) of the
# person/team to tag when the agent cannot verify an answer. Find it via the
# member's profile → "⋮" → "Copy member ID". Required.
#   U04FCR4PULQ = Ola Rasheed
ESCALATION_USER_ID=U04FCR4PULQ

# Per-product owners. Each falls back to ESCALATION_USER_ID.
#   U04FCR4PULQ = Ola Rasheed
#   U09FXC4B2N4 = Nora Alareer
ZAM_ESCALATION_USER_ID=U04FCR4PULQ
THEME_MARKET_ESCALATION_USER_ID=U09FXC4B2N4

# Hours before the same unanswered question may tag the owner again.
ESCALATION_COOLDOWN_HOURS=24

# Let owners close a knowledge gap from Slack by adding a reaction to the
# thread. The agent then saves whatever answer they wrote in that thread.
ENABLE_SLACK_RESOLUTION=true

# The reaction that means "confirmed". Removing it reopens the gap.
# A bare emoji name; ":white_check_mark:" is accepted too.
RESOLVE_REACTION=white_check_mark

# Extra people allowed to resolve, beyond the three escalation owners above.
# Anyone can add a reaction in a public channel, so this list is the actual
# authorisation: a reaction from anybody else is logged and ignored.
# Slack user IDs (U…) or user-group IDs (S…), comma-separated.
KNOWLEDGE_EDITOR_USER_IDS=

# ── Pushing an answer to the whole channel ───────────────────────────────────
# Answers normally stay in the thread of the question that prompted them. When
# one is worth everyone's attention, a named approver reacts with this emoji on
# the agent's answer and it is re-posted at channel level, with the original
# question for context and a link back to the thread.
ENABLE_BROADCAST=true

# The reaction that means "share this with the channel". 📣 is :mega:.
BROADCAST_REACTION=mega

# ONLY these people may push an answer to the channel. Reactions are public and
# anyone can add one, so this list is the actual authorisation — a 📣 from
# anybody else is logged and ignored. Empty means nothing is ever broadcast.
# Escalation owners and knowledge editors are NOT approvers unless listed here.
#   U04FCR4PULQ = Ola Rasheed
#   U09FXC4B2N4 = Nora Alareer
BROADCAST_APPROVER_USER_IDS=U04FCR4PULQ,U09FXC4B2N4

# ── Keeping technical issues out of the channel ──────────────────────────────
# The channel is for ZAM and Theme Market questions. When someone posts a
# HubSpot or Jira link, or describes a broken thing, the agent replies in-thread
# pointing them at HubSpot instead of answering. This is routing rather than an
# answer, so it posts immediately and is not gated on a 📣.
DEFLECT_TECHNICAL_ISSUES=true

# The ticket form the nudge links to. Without it the nudge still names HubSpot
# but cannot link the form. This is the link published in the channel topic.
HUBSPOT_TICKET_URL=https://share.hsforms.com/1NOrqOjsLQXCLxrxdAuzDng2tevd

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Main answering model.
CLAUDE_MODEL=claude-opus-5-5
# Classification and grounding verification default to CLAUDE_MODEL. Point them
# at a cheaper model (e.g. claude-sonnet-5-5) only after checking quality.
CLAUDE_CLASSIFIER_MODEL=
CLAUDE_GRADER_MODEL=

# Reasoning effort per stage: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_CLASSIFIER_EFFORT=low
CLAUDE_GRADER_EFFORT=medium

CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=90
CLAUDE_MAX_RETRIES=3
# Retry a safety-classifier decline on a fallback model instead of going silent.
CLAUDE_ENABLE_REFUSAL_FALLBACK=true

# ── Confidence and escalation thresholds ──────────────────────────────────────
# At or above CONFIDENCE_THRESHOLD the agent answers on its own.
# Between MEDIUM_CONFIDENCE_THRESHOLD and it, the agent clarifies or escalates.
# Below MEDIUM_CONFIDENCE_THRESHOLD the agent always escalates.
CONFIDENCE_THRESHOLD=0.68
MEDIUM_CONFIDENCE_THRESHOLD=0.40

# Hard gates — these force escalation regardless of the score above.
# Minimum share of the question's key terms that must appear in the sources.
MIN_EVIDENCE_COVERAGE=0.34
# Minimum share of the answer's claims the verifier must find supported.
MIN_SUPPORTED_CLAIM_RATIO=0.75
# How many unsupported claims are tolerated. 0 is the safe default.
MAX_UNSUPPORTED_CLAIMS=0

# ── Knowledge sources ─────────────────────────────────────────────────────────
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_SNAPSHOT_PATH=./data/knowledge_index.json
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.08
# A document with no `updated` date, or older than this, counts as stale and
# cannot by itself support a confident answer.
#
# 3 years rather than 1, because most of the corpus is synced from Zid's own
# published help centres, which carry their REAL upstream "last updated" date
# (some pages are genuinely from 2023 and still correct — a maintained help
# centre does not rot on a 365-day clock the way an internal note does). The
# dates are kept honest rather than reset on sync, so
# `python scripts/ingest.py --stale` still surfaces the oldest pages for the
# docs team. Lower this to 365 if you move to hand-written internal documents.
KNOWLEDGE_MAX_AGE_DAYS=1095
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=160

# Optional: Notion. Only the listed databases/pages are read, and they must be
# shared with the integration. Leave empty to disable.
NOTION_API_KEY=
NOTION_DATABASE_IDS=
NOTION_PAGE_IDS=

# Optional: Google Drive (service account, read-only). Share the approved
# folder or document with the service account's e-mail.
# Needs: pip install '.[gdrive]'
GOOGLE_DRIVE_CREDENTIALS_FILE=
# Whole folders (recursive).
GOOGLE_DRIVE_FOLDER_IDS=
# Individually approved documents, when the canonical source is one Doc rather
# than a folder. The ID is the long string in the Doc's URL:
#   https://docs.google.com/document/d/<FILE_ID>/edit
GOOGLE_DRIVE_FILE_IDS=

# Where `scripts/report_gaps.py --draft` writes captured answers for review.
# Must stay under a path the loader ignores (a name starting with "_"), so a
# draft cannot be quoted by the agent before a human promotes it.
KNOWLEDGE_DRAFT_DIR=./knowledge/_inbox

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Reply in a thread on the original message (keeps the channel readable).
ANSWER_IN_THREAD=true
# Reply to messages the classifier marks as unrelated chatter. Keep false.
RESPOND_TO_UNRELATED=false
# Only reply to questions / requests for information. Keep true.
RESPOND_ONLY_TO_QUESTIONS=true
# Skip the classifier call for messages with no question and no product
# keyword. Saves cost in a busy channel; set false to classify everything.
PREFILTER_ENABLED=true
# Answer company questions that are not ZAM/Theme-Market specific.
ANSWER_GENERAL_QUESTIONS=true
# Tag a human for a general company question with no matching source.
# Keep false: it would ping the owner about unrelated chatter.
ESCALATE_GENERAL_QUESTIONS=false
# Append "Source: <link>" to answers.
INCLUDE_SOURCE_LINKS=true
# Add a reaction to the question while the agent works on it.
ADD_ACK_REACTION=false
ACK_REACTION=eyes
# Prior messages read for a follow-up question in a thread.
MAX_THREAD_CONTEXT_MESSAGES=12

# ── Storage ───────────────────────────────────────────────────────────────────
# SQLite only in the bundled store. Mount a volume at this path in a container:
# event de-duplication and escalation state must survive a restart.
DATABASE_URL=sqlite:///./data/zam_agent.db

# ── Operations ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
WORKER_THREADS=4
# Process and log decisions but post nothing to Slack. Use for the first run.
DRY_RUN=false
